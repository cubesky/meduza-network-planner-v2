#!/bin/sh /etc/rc.common
# procd service for the Meduza NP updater (§13.1): independent of planner; never started or stopped by it.

START=96
STOP=09
USE_PROCD=1

start_service() {
	mkdir -p /etc/meduza-np-state /var/run/meduza-np
	procd_open_instance updater
	procd_set_param command /usr/lib/meduza-np/updater-run
	procd_set_param env MEDUZA_NP_DATA_DIR=/etc/meduza-np-state MEDUZA_NP_RUN_DIR=/var/run/meduza-np
	# exit 75 (self-update takeover) is handled inside the launcher; respawn covers crashes
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_close_instance
}
