{
  "manifestVersion": 1,
  "package": "meduza-np-planner",
  "version": "0.1.0",
  "role": "controller",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [],
  "conflicts": [],
  "provides": [
    "planner.core",
    "network.mappings",
    "network.port-forwards",
    "network.health-ports"
  ],
  "capabilitySwitches": [
    { "capability": "network.mappings", "pointer": "/mappings", "item": {} },
    { "capability": "network.port-forwards", "pointer": "/portForwards", "item": {} },
    { "capability": "network.health-ports", "pointer": "/healthPorts", "item": {} }
  ],
  "hostNetworkCapabilities": [
    "network.mappings",
    "network.port-forwards"
  ],
  "systemDependencies": [
    {
      "kind": "binary",
      "name": "nft",
      "when": "network.port-forwards"
    },
    {
      "kind": "binary",
      "name": "nft",
      "when": "network.mappings"
    },
    {
      "kind": "binary",
      "name": "ip"
    }
  ],
  "consumes": [
    "node",
    "networks.mappings",
    "networks.portForwards",
    "networks.healthPorts",
    "dns.hosts",
    "updatePolicy"
  ]
}
