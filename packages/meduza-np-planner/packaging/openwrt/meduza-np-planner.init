#!/bin/sh /etc/rc.common
# procd service for the Meduza NP planner (AGENT.md §11.2). The updater has its own init script and is never
# started or stopped from here.

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/meduza-np-planner

start_service() {
	mkdir -p /etc/meduza-np /etc/meduza-np-state /var/run/meduza-np
	chmod 0700 /etc/meduza-np /etc/meduza-np-state
	procd_open_instance planner
	procd_set_param command "$PROG" run
	# OpenWrt keeps persistent state on the overlay; /var is tmpfs.
	# split: INFO/DEBUG on stdout (logread daemon.info), WARN/ERROR on stderr (daemon.err), D55.
	procd_set_param env MEDUZA_NP_STATE_DIR=/etc/meduza-np-state MEDUZA_NP_RUN_DIR=/var/run/meduza-np MEDUZA_NP_LOG_TARGET=split
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_set_param file /etc/meduza-np/manager.json
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger meduza-np
}
