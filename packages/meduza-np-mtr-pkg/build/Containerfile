# Build context: packages/meduza-np-mtr-pkg. Native target build (QEMU for foreign architectures).
FROM docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS build
ARG TARGETPLATFORM
ARG BUILD_JOBS
COPY upstream.lock.json /recipe/
RUN apk add --no-cache jq && apk add --no-cache $(jq -r '.builder.apk | join(" ")' /recipe/upstream.lock.json)
COPY build/build.sh /recipe/
RUN BUILD_JOBS="$BUILD_JOBS" sh /recipe/build.sh /recipe/upstream.lock.json /out
FROM scratch
COPY --from=build /out/ /
