{
  "uiVersion": 1,
  "package": "meduza-np-mosdns",
  "requiresCapability": "mosdns.dns",
  "title": "MosDNS",
  "description": "DNS backend with domain sets and remote rule files. Rule downloads are atomic and keep the previous set on failure. Put the dnsmasq front end in front of it for fallback.",
  "settings": [
    {
      "path": "services.mosdns",
      "title": "MosDNS",
      "sections": [
        {
          "title": "监听与上游",
          "fields": [
            "enabled",
            "listen",
            "port",
            "localUpstreams",
            "remoteUpstreams",
            "remoteSocks5",
            "bootstrap",
            "cacheSize",
            "probeName"
          ]
        },
        {
          "title": "域名集合",
          "fields": [
            "domains.local",
            "domains.block",
            "domains.ddns",
            "domains.global"
          ]
        },
        {
          "title": "远程规则文件",
          "path": "ruleFiles",
          "widget": "editable-table",
          "fields": [
            "id",
            "enabled",
            "category",
            "url",
            "refreshHours"
          ]
        },
        {
          "title": "下载",
          "fields": [
            "download.proxy",
            "download.directFallback",
            "download.timeoutSeconds",
            "download.maxBytes"
          ]
        },
        {
          "title": "高级 YAML",
          "fields": [
            "advancedYaml"
          ],
          "widget": "yaml",
          "advanced": true
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "restart-instance",
      "label": "重启并刷新规则",
      "mutating": true
    }
  ],
  "status": [
    {
      "title": "MosDNS",
      "instanceKind": "mosdns",
      "columns": [
        "id",
        "state",
        "listen",
        "reason"
      ]
    },
    {
      "title": "规则文件",
      "instanceKind": "mosdns-rules",
      "columns": [
        "id",
        "state",
        "category",
        "ruleStatus",
        "updatedAt",
        "lastError"
      ]
    }
  ],
