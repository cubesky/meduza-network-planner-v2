{
  "manifestVersion": 1,
  "package": "meduza-np-mihomo-openwrt",
  "version": "0.1.0",
  "role": "service-adapter",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [
    "meduza-np-planner"
  ],
  "conflicts": [
    "meduza-np-mihomo",
    "meduza-np-mihomo-pkg"
  ],
  "provides": [
    "mihomo-openwrt.openclash",
    "mihomo-openwrt.dns",
    "mihomo-openwrt.subscriptions"
  ],
  "capabilitySwitches": [
    {
      "capability": "mihomo-openwrt.dns",
      "pointer": "/dnsIntegration"
    },
    {
      "capability": "mihomo-openwrt.subscriptions",
      "pointer": "/subscriptions"
    }
  ],
  "schemas": {
    "config": "schema/config.json",
    "status": "schema/status.json"
  },
  "ui": {
    "descriptor": "ui/descriptor.json",
    "version": 1
  },
  "entrypoint": "/usr/libexec/meduza-np/plugins/mihomo-openwrt",
  "operations": [
    "validate",
    "plan",
    "probe",
    "action"
  ],
  "systemDependencies": [
    {
      "kind": "service",
      "name": "openclash"
    }
  ],
  "consumes": [
    "services.mihomo-openwrt"
  ],
  "platforms": [
    "openwrt"
  ]
}
