{
  "uiVersion": 1,
  "package": "meduza-np-mihomo-openwrt",
  "requiresCapability": "mihomo-openwrt.openclash",
  "title": "Mihomo (OpenClash)",
  "description": "OpenClash runs Mihomo and owns its transparent-proxy rules and utun. This adapter only writes its own managed configuration file, selects it and records the original OpenClash options; disabling restores them. Ports, controller, DNS and TUN come from OpenClash settings and are shown as overridden.",
  "settings": [
    {
      "path": "services.mihomo-openwrt",
      "title": "OpenClash",
      "sections": [
        {
          "title": "接管",
          "fields": [
            "enabled",
            "configName",
            "select",
            "mode",
            "restartOnChange"
          ]
        },
        {
          "title": "订阅下载",
          "fields": [
            "downloadProxy"
          ]
        },
        {
          "title": "DNS",
          "fields": [
            "dnsIntegration"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "refresh-subscription",
      "label": "立即刷新订阅",
      "mutating": true
    },
    {
      "id": "detect",
      "label": "检测 OpenClash",
      "mutating": false
    },
    {
      "id": "preview-config",
      "label": "查看托管配置",
      "mutating": false
    },
    {
      "id": "reload-openclash",
      "label": "重启 OpenClash",
      "mutating": true
    },
    {
      "id": "restore-takeover",
      "label": "恢复接管前设置",
      "mutating": true
    }
  ],
  "status": [
    {
      "title": "OpenClash",
      "instanceKind": "openclash",
      "columns": [
        "id",
        "state",
        "reason",
        "openclashVersion",
        "coreVersion",
        "configPath",
        "selected",
        "enMode",
        "connections",
        "takenOver",
        "lastRestart"
      ]
    },
    {
      "title": "DNS",
      "instanceKind": "openclash-dns",
      "columns": [
        "id",
        "state",
        "listen",
        "reason"
      ]
    },
    {
      "title": "订阅",
      "instanceKind": "openclash-subscription",
      "columns": [
        "id",
        "state",
        "active",
        "updatedAt",
        "overriddenKeys",
        "lastError"
      ]
    }
  ],
