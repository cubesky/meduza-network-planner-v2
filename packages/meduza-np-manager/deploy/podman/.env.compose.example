# Copy to .env beside compose.yml. Use the manager package's OCI reference from the release manifest;
# the group tag need not equal the manager package version when an earlier image is reused.
MANAGER_IMAGE=ghcr.io/cubesky/meduza-np-manager@sha256:REPLACE_WITH_RELEASE_DIGEST
PUBLIC_ORIGIN=https://manager.example.com
# RP_ID defaults to manager.example.com. Keep the public hostname stable after registering passkeys.
# Set to the reverse proxy's address as seen inside the container, e.g. the Podman network gateway.
# Inspect after starting: podman network inspect meduza-np-manager
TRUSTED_PROXIES=
