# Meduza NP manager deployment parameters (AGENT.md §14.4.2). Copy to ~/.config/meduza-np-manager/manager.env.
# No secret values belong in this file: secrets are Podman secrets mounted under /run/secrets.

# Public HTTPS origin users and nodes use (required). Must match the reverse proxy's host name.
PUBLIC_ORIGIN=https://manager.example.test
# Passkey relying party id: the public host name or a registrable suffix of it. Changing it later
# invalidates every registered passkey.
RP_ID=manager.example.test
RP_NAME=Meduza NP Manager

LISTEN_HOST=0.0.0.0
PORT=8787
DATA_DIR=/var/lib/meduza-np-manager
CONFIG_FILE=/etc/meduza-np-manager/config.json

SESSION_SECRET_FILE=/run/secrets/session.key
SECRET_ENCRYPTION_KEY_FILE=/run/secrets/secret.key
# Only while registering the first administrator:
#BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap

# Addresses of the reverse proxy as seen from inside the container (rootless pasta/slirp source address or the
# podman network gateway). Forwarded headers from anyone else are ignored.
TRUSTED_PROXIES=10.89.0.1,127.0.0.1

# Capacity protection for node traffic (see docs: sizing).
MAX_CONCURRENT_STREAMS=5000
MAX_STREAM_HANDSHAKES_PER_SECOND=50
MAX_CONCURRENT_NODE_REQUESTS=64
PER_NODE_REQUESTS_PER_MINUTE=60

SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=3600
REAUTH_WINDOW_SECONDS=300
LOG_LEVEL=info
