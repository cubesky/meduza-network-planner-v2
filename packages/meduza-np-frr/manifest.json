{
  "manifestVersion": 1,
  "package": "meduza-np-frr",
  "version": "0.1.0",
  "role": "service-adapter",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [
    "meduza-np-planner"
  ],
  "conflicts": [],
  "provides": [
    "frr.bgp",
    "frr.bfd",
    "frr.anycast-ospf"
  ],
  "hostNetworkCapabilities": [
    "frr.bgp",
    "frr.bfd",
    "frr.anycast-ospf"
  ],
  "capabilitySwitches": [
    {
      "capability": "frr.anycast-ospf",
      "pointer": "/anycast/enabled"
    }
  ],
  "providerSlot": "frr.daemons",
  "schemas": {
    "config": "schema/config.json",
    "status": "schema/status.json"
  },
  "ui": {
    "descriptor": "ui/descriptor.json",
    "version": 1
  },
  "entrypoint": "/usr/libexec/meduza-np/plugins/frr",
  "operations": [
    "validate",
    "plan",
    "probe",
    "action"
  ],
  "systemDependencies": [
    {
      "kind": "binary",
      "name": "zebra",
      "providerSlot": "frr.daemons"
    },
    {
      "kind": "binary",
      "name": "bgpd"
    },
    {
      "kind": "binary",
      "name": "vtysh"
    },
    {
      "kind": "binary",
      "name": "ip"
    }
  ],
  "consumes": [
    "services.frr",
    "node.routerId",
    "networks.lan",
    "networks.privateLan",
    "networks.mappings",
    "routing"
  ]
}
