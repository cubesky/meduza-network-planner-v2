{
  "uiVersion": 1,
  "package": "meduza-np-avahi",
  "requiresCapability": "mdns.avahi",
  "title": "Avahi / mDNS",
  "description": "mDNS on selected interfaces. Reflection across interfaces is off by default. The optional .local bridge lets the dnsmasq front end answer A/AAAA for .local names through Avahi; the system resolver is never changed.",
  "settings": [
    {
      "path": "services.avahi",
      "title": "Avahi",
      "sections": [
        {
          "title": "运行",
          "fields": [
            "enabled",
            "mode",
            "hostName"
          ]
        },
        {
          "title": "接口",
          "fields": [
            "allowInterfaces",
            "denyInterfaces",
            "useIpv4",
            "useIpv6"
          ]
        },
        {
          "title": "发布",
          "fields": [
            "publish.addresses",
            "publish.workstation",
            "publish.services"
          ],
          "when": "mode == \"managed\""
        },
        {
          "title": "跨接口反射",
          "fields": [
            "reflector.enabled",
            "reflector.reflectIpv"
          ],
          "when": "mode == \"managed\""
        },
        {
          "title": ".local 解析桥接",
          "fields": [
            "bridge.enabled",
            "bridge.port",
            "bridge.maxInflight",
            "bridge.timeoutMs",
            "bridge.cacheSeconds"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "resolve",
      "label": "解析 .local 名称",
      "mutating": false
    },
    {
      "id": "restart-instance",
      "label": "重启",
      "mutating": true
    }
  ],
  "status": [
    {
      "title": "Avahi",
      "instanceKind": "avahi",
      "columns": [
        "id",
        "state",
        "reason",
        "mode",
        "version",
        "hostName",
        "activeInterfaces",
        "reflector"
      ]
    },
    {
      "title": "桥接",
      "instanceKind": "mdns-bridge",
      "columns": [
        "id",
        "state",
        "listen",
        "reason"
      ]
    }
  ],
  "i18n": {
