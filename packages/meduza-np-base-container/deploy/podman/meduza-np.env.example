# Meduza NP node deployment parameters (§14.3.1). Copy to /etc/meduza-np/node.env (Quadlet EnvironmentFile) or
# pass with `run.sh --env-file`. planner and updater are always installed; list only optional components.

# Optional components, short names: wireguard,tinc,openvpn,openvpn-pkg,frr,dnsmasq,mosdns,mosdns-pkg,mihomo,
# mihomo-pkg,avahi,cli,dashboard. Empty = planner + updater only. Conflicting combinations are refused.
MEDUZA_NP_COMPONENTS=

# macvlan bootstrap: BOTH planner and updater go directly to the main router, before any service/download.
# Requires MEDUZA_NP_NETWORK_MODE=macvlan (run.sh / macvlan Quadlet set it) and NET_ADMIN in each container.
# Empty/unset values retain the runtime's route and DNS. DNS applies to both roles in all network modes.
#MEDUZA_NP_DEFAULT_GW=192.168.1.1
#MEDUZA_NP_DEFAULT_GW_DEV=eth0
#MEDUZA_NP_DNS_NAMESERVERS=223.5.5.5,119.29.29.29
# Restore both gateway and DNS after runtime/DHCP renewals; never changes the leased IP address.
#MEDUZA_NP_NETWORK_MONITOR_INTERVAL=5
# Legacy interval alias (used if MEDUZA_NP_NETWORK_MONITOR_INTERVAL is unset):
#MEDUZA_NP_DNS_MONITOR_INTERVAL=5
# Old-image aliases still work: DEFAULT_GW, DEFAULT_GW_DEV, DNS_NAMESERVERS (or DNS_NAMESERVER),
# DNS_MONITOR_INTERVAL. MEDUZA_NP_* takes precedence, including an explicit empty value.

# Signed update source. Default: the project's GitHub Pages. An offline import directory works too:
#   MEDUZA_NP_UPDATE_BASE_URL=file:///var/lib/meduza-np/import   (mount it read-only into the updater container)
#MEDUZA_NP_UPDATE_BASE_URL=https://meduza-np.github.io/meduza-network-planner
MEDUZA_NP_UPDATE_CHANNEL=stable

# Pin an exact package group (no automatic moves past it). Unset = follow the channel.
#MEDUZA_NP_GROUP_VERSION=v0.2.0

# Automatic applies: 1/0, and an optional daily UTC window.
MEDUZA_NP_UPDATE_AUTO=1
#MEDUZA_NP_UPDATE_WINDOW=02:00-05:00

# Persistent data root inside both containers (volumes are mounted below it). Keep the default.
MEDUZA_NP_DATA_DIR=/var/lib/meduza-np

# First start only: enroll this node with the manager (token is single use). Prefer the _FILE variant (secret).
#MEDUZA_NP_ENROLL_URL=https://manager.example.net
#MEDUZA_NP_ENROLL_TOKEN_FILE=/run/secrets/meduza-np-enroll-token
