{
  "uiVersion": 1,
  "package": "meduza-np-mihomo",
  "requiresCapability": "mihomo.proxy",
  "title": "Mihomo",
  "description": "Proxy with subscriptions. Fields this project controls (listeners, API, DNS, TUN) are always overridden and shown in the subscription status. TPROXY only affects forwarded traffic from the selected sources.",
  "settings": [
    {
      "path": "services.mihomo",
      "title": "Mihomo",
      "sections": [
        {
          "title": "运行模式",
          "fields": [
            "enabled",
            "mode",
            "mixedPort",
            "allowLan",
            "bindAddress"
          ]
        },
        {
          "title": "控制 API",
          "fields": [
            "api.address",
            "api.port",
            "api.secretRef"
          ],
          "widget": "secret"
        },
        {
          "title": "订阅下载",
          "fields": [
            "downloadProxy"
          ]
        },
        {
          "title": "DNS",
          "fields": [
            "dns.enabled",
            "dns.listen",
            "dns.fakeIp",
            "dns.nameservers",
            "dns.defaultNameservers"
          ]
        },
        {
          "title": "TPROXY",
          "fields": [
            "tproxy.port",
            "tproxy.sources",
            "tproxy.inboundInterfaces",
            "tproxy.excludeSources",
            "tproxy.excludePrivateDestinations",
            "tproxy.excludeDestinations",
            "tproxy.protocols",
            "tproxy.excludePorts",
            "tproxy.useConntrack",
            "tproxy.bypassRouted"
          ],
          "when": "mode == \"tproxy\""
        },
        {
          "title": "旁路由",
          "fields": [
            "tproxy.sideRouter"
          ],
          "when": "mode == \"tproxy\""
        },
        {
          "title": "标记与路由表",
          "fields": [
            "tproxy.fwmark",
            "tproxy.routeTable",
            "tproxy.rulePriority"
          ],
          "advanced": true
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "refresh-subscription",
      "label": "立即刷新订阅",
      "mutating": true
    },
    {
      "id": "preview-config",
      "label": "查看最终配置",
      "mutating": false
    },
    {
      "id": "restart-instance",
      "label": "重启",
      "mutating": true
    }
  ],
  "status": [
    {
      "title": "Mihomo",
      "instanceKind": "mihomo",
      "columns": [
        "id",
        "state",
        "mode",
        "provider",
        "version",
        "connections",
        "proxyServerSet"
      ]
    },
    {
      "title": "DNS",
      "instanceKind": "mihomo-dns",
      "columns": [
        "id",
        "state",
        "listen",
        "reason"
      ]
    },
    {
      "title": "订阅",
      "instanceKind": "mihomo-subscription",
      "columns": [
        "id",
        "state",
        "active",
        "updatedAt",
        "overriddenKeys",
        "lastError"
      ]
    }
  ],
  "i18n": {
    "en": {
      "text": {
        "当前订阅": "Active subscription",
