{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mihomo provider status",
  "type": "object",
  "required": [
    "id",
    "kind",
    "state"
  ],
  "properties": {
    "kind": {
      "const": "mihomo-provider"
    },
    "source": {
      "enum": [
        "github-release",
        "user-provided",
        null
      ]
    },
    "providerState": {
      "enum": [
        "registered",
        "invalid",
        "waiting-binary",
        "download-failed"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "packageVersion": {
      "type": "string"
    },
    "upstreamVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "activeSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "downloadStage": {
      "type": [
        "string",
        "null"
      ]
    },
    "preparerProcess": {
      "type": "string"
    },
    "downloadProgress": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "phase",
        "active",
        "targetVersion",
        "downloadedBytes",
        "bytesTotal",
        "attempt"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "targetVersion": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "downloadedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "bytesTotal": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "retryAtUnix": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
