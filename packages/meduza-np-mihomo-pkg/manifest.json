{
  "manifestVersion": 1,
  "package": "meduza-np-mihomo-pkg",
  "version": "0.1.1",
  "role": "binary-provider",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [
    "meduza-np-planner"
  ],
  "conflicts": [
    "meduza-np-mihomo-openwrt"
  ],
  "provides": [
    "mihomo.binary",
    "mihomo-pkg.provider"
  ],
  "providers": [
    {
      "slot": "mihomo.binary",
      "binary": "mihomo",
      "versionArgs": [
        "-v"
      ],
      "requiresPreparation": true,
      "dataDir": "/var/lib/meduza-np/providers/mihomo"
    }
  ],
  "ui": {
    "descriptor": "ui/descriptor.json",
    "version": 1
  },
  "schemas": {
    "config": "schema/config.json",
    "status": "schema/status.json"
  },
  "entrypoint": "/usr/libexec/meduza-np/plugins/mihomo-pkg",
  "operations": [
    "validate",
    "plan",
    "probe",
    "action"
  ],
  "consumes": [
    "services.mihomo-pkg"
  ]
}
