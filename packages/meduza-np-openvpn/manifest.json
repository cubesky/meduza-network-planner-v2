{
  "manifestVersion": 1,
  "package": "meduza-np-openvpn",
  "version": "0.1.0",
  "role": "service-adapter",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [
    "meduza-np-planner"
  ],
  "conflicts": [],
  "provides": [
    "openvpn.site2site",
    "openvpn.access",
    "openvpn.keygen"
  ],
  "capabilitySwitches": [
    {
      "capability": "openvpn.access",
      "pointer": "/instances",
      "item": {
        "kind": "access"
      }
    }
  ],
  "providerSlot": "openvpn.binary",
  "schemas": {
    "config": "schema/config.json",
    "status": "schema/status.json"
  },
  "ui": {
    "descriptor": "ui/descriptor.json",
    "version": 1
  },
  "entrypoint": "/usr/libexec/meduza-np/plugins/openvpn",
  "operations": [
    "validate",
    "plan",
    "probe",
    "action"
  ],
  "systemDependencies": [
    {
      "kind": "binary",
      "name": "openvpn",
      "providerSlot": "openvpn.binary"
    },
    {
      "kind": "kernel-feature",
      "name": "tun"
    }
  ],
  "consumes": [
    "services.openvpn",
    "networks.lan",
    "networks.privateLan",
    "networks.mappings",
    "routing"
  ]
}
