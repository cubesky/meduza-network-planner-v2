{
  "uiVersion": 1,
  "package": "meduza-np-openvpn",
  "requiresCapability": "openvpn.site2site",
  "title": "OpenVPN",
  "description": "Independent Site2Site tunnels and Access servers. Clients never accept pushed routes unless allowed; Access logins are checked against OpenLDAP through the manager.",
  "collections": [
    {
      "path": "services.openvpn.instances",
      "itemId": "id",
      "title": "实例",
      "columns": [
        "id",
        "name",
        "kind",
        "role",
        "enabled",
        "port",
        "runtime.state",
        "runtime.clients"
      ],
      "sections": [
        {
          "title": "身份与运行",
          "fields": [
            "id",
            "name",
            "enabled",
            "kind",
            "role",
            "topology",
            "device",
            "devType",
            "proto",
            "local",
            "port"
          ]
        },
        {
          "title": "对端",
          "fields": [
            "remotes",
            "publicEndpoint"
          ],
          "when": "kind == \"site2site\""
        },
        {
          "title": "链路",
          "fields": [
            "ifconfig",
            "serverNetwork",
            "keepalive",
            "persistKey",
            "persistTun",
            "tunMtu",
            "mssfix",
            "verb",
            "compression"
          ]
        },
        {
          "title": "证书与密钥",
          "fields": [
            "tls.caRef",
            "tls.certRef",
            "tls.keyRef",
            "tls.crlRef",
            "tls.dhRef",
            "tls.tlsCryptRef",
            "tls.tlsAuthRef",
            "tls.keyDirection",
            "staticKeyRef",
            "staticKeyDirection"
          ],
          "widget": "certificate"
        },
        {
          "title": "TLS 校验",
          "fields": [
            "tls.remoteCertTls",
            "tls.verifyX509Name",
            "tls.tlsVersionMin",
            "auth",
            "cipher",
            "dataCiphers"
          ]
        },
        {
          "title": "路由",
          "fields": [
            "pull",
            "acceptRoutes",
            "routes"
          ],
          "when": "kind == \"site2site\""
        },
        {
          "title": "BGP",
          "fields": [
            "bgp.remoteAsn",
            "bgp.enabled",
            "bgp.address",
            "bgp.accept",
            "bgp.acceptDefault",
            "bgp.exportLan",
            "bgp.exportInternal",
            "bgp.exportMappings",
            "bgp.exportAccessPools",
            "bgp.exportDefaultRoute",
            "bgp.exportExtra",
            "bgp.noTransit",
            "bgp.noForward",
            "bgp.bfd",
            "bgp.keepalive",
            "bgp.hold",
            "bgp.passwordRef",
            "bgp.localPreference"
          ],
          "when": "kind == \"site2site\""
        },
        {
          "title": "Access",
          "fields": [
            "access.pool",
            "access.clientCert",
            "access.maxClients",
            "access.pushRoutes",
            "access.pushDns",
            "access.pushDomain",
            "access.renegSeconds",
            "access.authToken",
            "access.clientToClient"
          ],
          "when": "kind == \"access\""
        }
      ],
      "actions": [
        {
          "id": "restart-instance",
          "label": "重启",
          "mutating": true,
          "confirm": "重启会断开该实例的所有连接。"
        },
        {
          "id": "show-config",
          "label": "查看生成配置",
          "mutating": false
        }
      ],
      "runtimeKind": "openvpn-site2site"
    }
  ],
  "status": [
    {
      "title": "Access 在线客户端",
      "instanceKind": "openvpn-client",
      "columns": [
        "id",
        "username",
        "commonName",
        "realAddress",
        "virtualAddress",
        "rxBytes",
        "txBytes",
        "connectedSince"
      ]
    },
    {
      "title": "Site2Site 会话",
      "instanceKind": "openvpn-site2site",
      "columns": [
        "id",
        "state",
        "session",
        "remote",
        "since",
        "processRunning",
        "devicePresent",
        "reason"
      ]
    },
    {
      "title": "Access 服务",
      "instanceKind": "openvpn-access",
      "columns": [
        "id",
        "state",
        "clients",
        "processRunning",
        "devicePresent",
        "statusUpdated",
        "reason"
      ]
    }
  ],
