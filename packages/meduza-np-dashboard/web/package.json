{
  "name": "@meduza-np/dashboard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meduza NP node dashboard UI (Vite + Preact), served by the Rust meduza-np-dashboard binary",
  "scripts": {
    "build": "tsc --noEmit -p . && vite build && node compress.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test ../test/*.test.mjs",
    "dev": "vite"
  },
  "devDependencies": {
    "@meduza-np/descriptor-renderer": "workspace:*",
    "@meduza-np/ui-kit": "workspace:*",
    "@preact/preset-vite": "2.10.6",
    "preact": "10.29.8",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "meduzaNp": {
    "bundled": [
      "preact"
    ]
  }
}
