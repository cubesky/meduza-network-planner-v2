{
  "uiVersion": 1,
  "package": "meduza-np-dnsmasq",
  "requiresCapability": "dns.frontend",
  "title": "前置 DNS (dnsmasq)",
  "description": "Client-facing DNS. Starts on the fallback servers; MosDNS / Mihomo DNS are added only after real queries succeed and removed when they fail. No DHCP; /etc/resolv.conf is not changed.",
  "settings": [
    {
      "path": "services.dnsmasq",
      "title": "前端",
      "sections": [
        {
          "title": "监听",
          "fields": [
            "enabled",
            "listenAddresses",
            "port"
          ]
        },
        {
          "title": "Fallback 与后端",
          "fields": [
            "fallbackServers",
            "strategy",
            "probeName"
          ]
        },
        {
          "title": "后端",
          "path": "backends",
          "widget": "editable-table",
          "fields": [
            "id",
            "kind",
            "enabled",
            "address",
            "port",
            "priority"
          ]
        },
        {
          "title": "本地",
          "fields": [
            "localTtl",
            "cacheSize",
            "mdnsForward"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "restart-instance",
      "label": "重启前端",
      "mutating": true,
      "confirm": "重启期间客户端解析会短暂中断。"
    }
  ],
  "status": [
    {
      "title": "前端",
      "instanceKind": "dns-frontend",
      "columns": [
        "id",
        "state",
        "fallbackActive",
        "fallbackVerified",
        "upstreams"
      ]
    },
    {
      "title": "后端就绪",
      "instanceKind": "dns-backend",
      "columns": [
        "id",
        "state",
        "backend",
        "address",
        "priority",
        "reason"
      ]
    }
  ],
