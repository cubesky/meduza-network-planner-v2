{
  "manifestVersion": 1,
  "package": "meduza-np-wireguard",
  "version": "0.1.0",
  "role": "service-adapter",
  "plannerApi": {
    "min": 1,
    "max": 1
  },
  "requires": [
    "meduza-np-planner"
  ],
  "conflicts": [],
  "provides": [
    "wireguard.interfaces",
    "wireguard.keygen"
  ],
  "schemas": {
    "config": "schema/config.json",
    "status": "schema/status.json"
  },
  "ui": {
    "descriptor": "ui/descriptor.json",
    "version": 1
  },
  "entrypoint": "/usr/libexec/meduza-np/plugins/wireguard",
  "operations": [
    "validate",
    "plan",
    "probe",
    "action"
  ],
  "systemDependencies": [
    {
      "kind": "binary",
      "name": "wg",
      "providerSlot": "wireguard.tools"
    },
    {
      "kind": "binary",
      "name": "ip"
    },
    {
      "kind": "kernel-module",
      "name": "wireguard"
    }
  ],
  "consumes": [
    "services.wireguard"
  ],
  "providerSlot": "wireguard.tools"
}
