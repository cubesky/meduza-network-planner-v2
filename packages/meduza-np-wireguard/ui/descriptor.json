{
  "uiVersion": 1,
  "package": "meduza-np-wireguard",
  "requiresCapability": "wireguard.interfaces",
  "title": "WireGuard",
  "description": "Kernel WireGuard interfaces and peers. AllowedIPs select peers; they do not install routes.",
  "collections": [
    {
      "path": "services.wireguard.instances",
      "itemId": "id",
      "title": "接口",
      "runtimeKind": "wireguard-interface",
      "columns": [
        "name",
        "device",
        "enabled",
        "listenPort",
        "runtime.state",
        "runtime.publicKey"
      ],
      "sections": [
        {
          "title": "接口",
          "fields": [
            "id",
            "name",
            "enabled",
            "device",
            "addresses",
            "listenPort",
            "mtu",
            "publicEndpoint"
          ]
        },
        {
          "title": "密钥",
          "fields": [
            "privateKeyRef",
            "publicKey"
          ],
          "widget": "keypair"
        },
        {
          "title": "Peers",
          "path": "peers",
          "widget": "editable-table",
          "fields": [
            "id",
            "name",
            "enabled",
            "publicKey",
            "presharedKeyRef",
            "allowedIps",
            "endpoint",
            "persistentKeepalive",
            "bgp.remoteAsn",
            "bgp.enabled",
            "bgp.address",
            "bgp.accept",
            "bgp.acceptDefault",
            "bgp.exportLan",
            "bgp.exportInternal",
            "bgp.exportMappings",
            "bgp.exportAccessPools",
            "bgp.exportDefaultRoute",
            "bgp.exportExtra",
            "bgp.noTransit",
            "bgp.noForward",
            "bgp.bfd",
            "bgp.keepalive",
            "bgp.hold",
            "bgp.passwordRef",
            "bgp.localPreference"
          ]
        },
        {
          "title": "高级",
          "fields": [
            "fwmark",
            "handshakeTimeoutSeconds"
          ],
          "advanced": true
        }
      ],
      "actions": [
        {
          "id": "generate-keypair",
          "label": "生成密钥对",
          "mutating": true,
          "confirm": "生成新私钥后，所有对端必须更新公钥，现有连接会中断。"
        },
        {
          "id": "restart-instance",
          "label": "重载接口",
          "mutating": true
        },
        {
          "id": "export-wg-quick",
          "label": "导出 wg-quick 配置",
          "mutating": false,
          "role": "admin",
          "reauth": true
        }
      ]
    }
  ],
  "status": [
    {
      "title": "Peer 握手",
      "instanceKind": "wireguard-peer",
      "columns": [
        "id",
        "state",
        "latestHandshake",
        "endpoint",
        "rxBytes",
        "txBytes",
        "reasonCode"
      ]
    }
  ],
  "i18n": {
