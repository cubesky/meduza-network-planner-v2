{
  "name": "@meduza-np/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Preact controls: forms, status tables, key widgets",
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./src/styles.css",
    "./package-progress": "./src/package-progress.tsx",
