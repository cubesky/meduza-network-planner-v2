{
  "schemaVersion": 1,
  "nodes": {
    "lab-a": {
      "behavior": "static",
      "networks": { "lan": ["10.61.0.0/24"] },
      "services": {
        "wireguard": {
          "instances": [
            {
              "id": "wg0",
              "privateKeyRef": "wg-lab-a",
              "addresses": ["10.99.0.1/24"],
              "listenPort": 51820,
              "publicEndpoint": "10.50.0.11:51820",
              "peers": [
                { "id": "lab-b", "node": "lab-b", "instance": "wg0" },
                { "id": "lab-roam", "node": "lab-roam", "instance": "wg0" }
              ]
            }
          ]
        }
      }
    },
    "lab-b": {
      "behavior": "static",
      "networks": { "lan": ["10.62.0.0/24"] },
      "services": {
        "wireguard": {
          "instances": [
            {
              "id": "wg0",
              "privateKeyRef": "wg-lab-b",
              "addresses": ["10.99.0.2/24"],
              "listenPort": 51820,
              "publicEndpoint": "10.50.0.12:51820",
              "peers": [
                { "id": "lab-a", "node": "lab-a", "instance": "wg0" },
                { "id": "lab-roam", "node": "lab-roam", "instance": "wg0" }
              ]
            }
          ]
        }
      }
    },
    "lab-roam": {
      "behavior": "roaming",
      "services": {
        "wireguard": {
          "instances": [
            {
              "id": "wg0",
              "privateKeyRef": "wg-lab-roam",
              "addresses": ["10.99.0.3/24"],
              "peers": [
                { "id": "lab-a", "node": "lab-a", "instance": "wg0", "persistentKeepalive": 15 },
                { "id": "lab-b", "node": "lab-b", "instance": "wg0", "persistentKeepalive": 15 }
              ]
            }
          ]
        }
      }
    }
  }
}
